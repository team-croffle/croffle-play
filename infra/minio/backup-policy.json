{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupReadOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::games",
        "arn:aws:s3:::games/*",
        "arn:aws:s3:::adapters",
        "arn:aws:s3:::adapters/*"
      ]
    }
  ]
}
