# Croffle Play edge for game bundles and host adapters (design invariants 2, 3, 6).
#
#   https://<id>.${GAME_DOMAIN}/<version>/<path>  →  storage games/<id>/<version>/<path>
#   https://${STATIC_HOST}/adapters/v<N>/<ver>/…   →  storage adapters/v<N>/<ver>/…
#
# Rendered at container start by the nginx image (envsubst on /etc/nginx/templates/*.template);
# only the variables listed in infra/README.md are substituted, nginx's own $variables are kept.

resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

# Raw path without the query string; keeps the client's percent-encoding.
map $request_uri $raw_path {
    "~^(?<p>[^?]*)" $p;
}

map $game $game_reserved {
    default 0;
    "~^(www|api|admin|cdn|play|rooms|auth|static|preview|srv)$" 1;
}

# Traversal and encoded separators are refused before anything reaches storage: a path like
# /1.0.0/../../other-game/… must never serve another game's files on this game's origin.
map $raw_path $bad_path {
    default 0;
    "~*(\.\./|/\.\.|%2e|%2f|%5c|\\|//)" 1;
}

# Directory requests get their index.html.
map $raw_path $object_path {
    "~/$" "${raw_path}index.html";
    default $raw_path;
}

server {
    listen 8080 default_server;
    server_name _;
    return 404;
}

server {
    listen 8080;
    server_name "~^(?<game>[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?)\.${GAME_DOMAIN_REGEX}$";

    set $csp "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob: ${ROOMS_ORIGIN} https://$game.srv.${GAME_DOMAIN} wss://$game.srv.${GAME_DOMAIN}; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors ${PLATFORM_ORIGIN}";

    if ($game_reserved) {
        return 404;
    }
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }
    if ($bad_path) {
        return 400;
    }

    # Storage headers that must not reach players. Games never get cookies (invariant 3).
    proxy_hide_header Set-Cookie;
    proxy_ignore_headers Set-Cookie;
    proxy_hide_header Cache-Control;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Xss-Protection;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Amz-Request-Id;
    proxy_hide_header X-Amz-Id-2;
    proxy_hide_header X-Amz-Checksum-Sha256;
    proxy_hide_header X-Ratelimit-Limit;
    proxy_hide_header X-Ratelimit-Remaining;
    # Storage answers CORS for any origin; only the rules below apply.
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Vary;

    location ~ "^/(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?/" {
        proxy_pass http://${STORAGE_UPSTREAM}/games/$game$object_path;
        proxy_set_header Host ${STORAGE_UPSTREAM};
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_http_version 1.1;
        proxy_intercept_errors on;
        error_page 400 403 404 = @missing;

        # Versions are immutable (invariant 2): cache successful responses forever.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    # Unversioned paths are never served: the shell resolves which version to play.
    location / {
        return 404;
    }

    location @missing {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options nosniff always;
        return 404 "not found\n";
    }
}

server {
    listen 8080;
    server_name ${STATIC_HOST};

    if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
        return 405;
    }
    if ($bad_path) {
        return 400;
    }

    proxy_hide_header Set-Cookie;
    proxy_ignore_headers Set-Cookie;
    proxy_hide_header Cache-Control;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Amz-Request-Id;
    proxy_hide_header X-Amz-Id-2;
    # Storage answers CORS for any origin; only the rules below apply.
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Vary;

    # Host adapters: fetched by the shell, verified against their SRI hash, then imported.
    location ~ "^/adapters/v[0-9]+/[0-9A-Za-z.-]+/(index\.js|manifest\.json)$" {
        proxy_pass http://${STORAGE_UPSTREAM}$raw_path;
        proxy_set_header Host ${STORAGE_UPSTREAM};
        proxy_set_header Authorization "";
        proxy_intercept_errors on;
        error_page 403 404 = @missing;

        add_header Access-Control-Allow-Origin ${PLATFORM_ORIGIN} always;
        add_header Vary Origin always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        return 404;
    }

    location @missing {
        add_header Cache-Control "no-store" always;
        return 404 "not found\n";
    }
}
