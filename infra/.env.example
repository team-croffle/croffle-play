# Copy to infra/.env (gitignored) and replace every value marked CHANGE_ME.
POSTGRES_USER=play
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=play
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
# API storage user (least privilege, created by minio-init).
S3_ACCESS_KEY_ID=play-api
S3_SECRET_ACCESS_KEY=CHANGE_ME_min_8_chars
# Host in presigned upload URLs (CI runners PUT bundles here).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Sign-in (Logto). Client id/secret of the shell's "traditional web" application.
SITE_URL=https://play.croffledev.kr
OIDC_ISSUER=https://auth.play.croffledev.kr/oidc
OIDC_AUDIENCE=https://api.play.croffledev.kr
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
# IdP subjects that become admins when they sign in (comma-separated).
ADMIN_SUBS=
# Game token signing key (ES256). Generate and put on one line with \n escapes:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n", $0}'
JWT_SIGNING_KEY=CHANGE_ME
PUBLIC_API_ORIGIN=https://api.play.croffledev.kr
# Seals the shell session cookie (≥ 32 chars).
NUXT_SESSION_PASSWORD=CHANGE_ME_at_least_32_characters_long
# Insert the dummy catalog on boot. Development only (refused when NODE_ENV=production).
DB_SEED=false
NODE_ENV=production
# Where game versions are served; {id} and {version} are replaced. https:// in production.
GAME_URL_TEMPLATE=https://{id}.croffle-play.link/{version}/
# On the server, use released images instead of local builds:
# API_IMAGE=ghcr.io/team-croffle/croffle-play/api:0.1.0
# SHELL_IMAGE=ghcr.io/team-croffle/croffle-play/shell:0.1.0
# Shell CSP: where games are framed from and where adapters are fetched from.
NUXT_CSP_FRAME_SRC=https://*.croffle-play.link
NUXT_CSP_CONNECT_SRC=https://static.play.croffledev.kr
# games-edge (nginx)
GAME_DOMAIN=croffle-play.link
GAME_DOMAIN_REGEX=croffle-play\.link
STATIC_HOST=static.play.croffledev.kr
PLATFORM_ORIGIN=https://play.croffledev.kr
ROOMS_ORIGIN=wss://rooms.play.croffledev.kr
# Rooms server URL games connect to.
ROOMS_URL=wss://rooms.play.croffledev.kr
# On the server: ROOMS_IMAGE=ghcr.io/team-croffle/croffle-play/rooms:<version>
# SDK deprecation issues in game repositories (fine-grained PAT, Issues: write). Optional.
GITHUB_NOTIFY_TOKEN=
# Backups (ops service): read-only storage user, host directory, retention.
BACKUP_S3_ACCESS_KEY=play-backup
BACKUP_S3_SECRET_KEY=CHANGE_ME_min_8_chars
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14
# Discord webhook for down/up alerts (optional).
ALERT_WEBHOOK_URL=
