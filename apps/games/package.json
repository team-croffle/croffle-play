{
  "name": "@croffledev/play-games",
  "version": "0.0.0",
  "private": true,
  "description": "Croffle Play game host: serves uploaded game builds at <id>.play.<domain> from storage",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@croffledev/source --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@croffledev/play-protocol": "workspace:^",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
