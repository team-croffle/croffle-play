# Copy to apps/games/.env for `pnpm --filter @croffledev/play-games dev`.
PORT=3003
# Which game a request is for: the Host header must match this with one DNS label as {id}.
GAME_ORIGIN_TEMPLATE=http://{id}.localhost:3003
# The portal, allowed to frame the games (Content-Security-Policy: frame-ancestors).
PORTAL_ORIGIN=http://localhost:3000
# Same bucket as the api (S3 API only); builds live under games/<id>/.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=croffle-play
