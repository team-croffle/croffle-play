# Copy to apps/shell/.env for `pnpm dev:shell`.
NUXT_API_BASE=http://localhost:3001
# Sign-in with `pnpm dev:oidc` (any login name; `admin` is an admin with ADMIN_SUBS=admin on the API):
NUXT_OIDC_ISSUER=http://localhost:4300
NUXT_OIDC_CLIENT_ID=croffle-play-shell
NUXT_OIDC_CLIENT_SECRET=dev-secret
NUXT_OIDC_AUDIENCE=http://localhost:3001
# Production: ≥ 32 random characters. Development generates one per process when unset.
# NUXT_SESSION_PASSWORD=
# Production: where games are framed from (their origins) — e.g. https://*.play.croffle-play.link.
# Development leaves it empty and allows `pnpm dev:games` (*.localhost:4100).
# NUXT_CSP_FRAME_SRC=
# Keep session data in a Redis-protocol server (e.g. Valkey) instead of the cookie:
# NUXT_SESSION_REDIS_URL=redis://valkey:6379/0
