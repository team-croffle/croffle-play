# Copy to apps/api/.env for `pnpm dev:api`. Values here are local-only placeholders.
PORT=3001
DATABASE_URL=postgres://play:play@localhost:5432/play
# No Docker? Embedded Postgres (in memory) with the dummy catalog:
# DATABASE_URL=pglite://memory
# DB_SEED=true
# DB_MIGRATE=true
# DB_POOL_SIZE=10
# Local game/adapter server from `pnpm dev:games`:
# GAME_ORIGIN_TEMPLATE=http://{id}.localhost:4100
# SEED_ADAPTER_MANIFEST_URL=http://localhost:4100/adapters/v1/dev/manifest.json
# Sign-in with `pnpm dev:oidc`:
# OIDC_ISSUER=http://localhost:4300
# OIDC_AUDIENCE=http://localhost:3001
# ADMIN_SUBS=admin
