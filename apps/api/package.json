{
  "name": "@croffledev/play-api",
  "version": "0.0.0",
  "private": true,
  "description": "Croffle Play platform API (catalog, publish, scores, tokens)",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@croffledev/source --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --conditions=@croffledev/source --env-file-if-exists=.env src/db/seed-cli.ts",
    "sdk:register": "tsx --conditions=@croffledev/source --env-file-if-exists=.env src/sdk/register-cli.ts",
    "db:grant-admin": "tsx --conditions=@croffledev/source --env-file-if-exists=.env src/auth/grant-admin-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@croffledev/play-protocol": "workspace:^",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
