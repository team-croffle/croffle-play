{
  "name": "@croffledev/play-rooms",
  "version": "0.0.0",
  "private": true,
  "description": "Croffle Play shared rooms server: WebSocket relay for multiplayer games",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@croffledev/source --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@croffledev/play-protocol": "workspace:^",
    "jose": "^6.2.12",
    "valibot": "^1.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
