{
  "name": "@croffledev/play-protocol",
  "version": "0.2.1",
  "description": "Croffle Play game ↔ platform protocol: frozen handshake, SDK v1 messages, host core contract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-croffle/croffle-play.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@croffledev/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./host": {
      "@croffledev/source": "./src/host.ts",
      "types": "./dist/host.d.mts",
      "import": "./dist/host.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
