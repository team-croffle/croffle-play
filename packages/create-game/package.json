{
  "name": "@croffledev/create-play-game",
  "version": "0.2.2",
  "description": "Create a Croffle Play game: npm create @croffledev/play-game",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-croffle/croffle-play.git",
    "directory": "packages/create-game"
  },
  "type": "module",
  "bin": {
    "create-play-game": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "@croffledev/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@croffledev/play-protocol": "workspace:^"
  },
  "devDependencies": {
    "@croffledev/play-cli": "workspace:^",
    "@croffledev/play-sdk": "workspace:^",
    "@types/node": "^24.19.1",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
